<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ai.workbench</groupId>
        <artifactId>ai-workbench</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-platform</artifactId>
    <name>app-platform</name>
    <description>平台数据服务：登录认证、用户管理、工作台统计、平台监控、平台知识库与数据源接口（8080）</description>

    <dependencies>
        <dependency>
            <groupId>com.ai.workbench</groupId>
            <artifactId>platform-core</artifactId>
        </dependency>
        <!--
          BCrypt 密码校验：只用 crypto 模块，不引入 Spring Security 全家桶。
          JWT（jjwt）随 JwtService 位于 platform-core，经依赖传递获得，无需重复声明。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 应用进程工作目录固定为仓库根：spring-dotenv 从 cwd 读取 .env，
                         否则 spring-boot:run 默认用模块目录，导致 .env 加载不到 -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- 单元测试 *Test 与集成测试 *IT 统一在 mvn test 执行；
                         集成测试需要真实 MySQL，连不上时由 Assumptions 自动跳过 -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
